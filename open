#!/usr/bin/env bash
set -euo pipefail

VERSION="1.1.0"
REPO="yannlugrin/winopen"

die() {
  echo "open: $*" >&2
  exit 1
}

# For what could not be honoured but does not stop the target being opened.
# Refusing is right when a flag contradicts the target -- a URL has no
# enclosing folder for -D to show. It is wrong when the flag is a guarantee we
# cannot offer, as -n is for an application whose flag we do not know: the open
# itself is still valid, and denying it outright costs the caller everything
# over a preference that might have been satisfied anyway.
warn() {
  echo "open: $*" >&2
}

usage() {
  cat <<'EOF'
Usage: open [-a app] [-u url] [-DeRtWfn] [target ...] [--args arg ...]

Open files, directories, and URLs from WSL using Windows applications.

Flags:
  -a <app>     Open with a specific Windows application
  -u <url>     Open a URL with whatever application claims its scheme,
               even if a file of that name exists
  -D           Open the enclosing folder in Explorer
  -R           Reveal in Explorer (highlight the file)
  -e           Open in notepad.exe
  -t           Open in the default text editor ($WINOPEN_EDITOR, else whatever
               Windows registered for .txt)
  -W           Wait for the application to exit
  -n           Open a new instance, rather than reusing a running one
  -f           Read stdin into a temp file, then open it in the text editor
  --args <...> Pass all remaining arguments to the launched application
  --           Treat all remaining arguments as targets
  -h, --help   Show this help
  -V, --version  Show version
  --check-update  Check if a newer version is available
  --update        Update to the latest version
  --install-xdg   Install an xdg-open shim beside open, or into $PREFIX/bin
  --uninstall-xdg Remove the xdg-open shim and restore any backup
EOF
}

xdg_usage() {
  cat <<'EOF'
Usage: xdg-open { file | URL }
       xdg-open { --help | --manual | --version }

winopen's xdg-open shim: opens the target with the Windows application that
claims it. Installed by `open --install-xdg`, removed by `open --uninstall-xdg`.

Set WINOPEN_XDG=0 to bypass the shim and use the xdg-open it shadows.

Exit codes: 0 success, 1 command line syntax, 2 file did not exist,
3 no xdg-open to delegate to.
EOF
}

# The releases/latest page redirects to the tag it resolves to, which answers
# the same question as the API without its 60-requests-an-hour limit for
# unauthenticated callers, and without parsing JSON with grep.
fetch_latest_version() {
  local url
  url="$(curl -fsI -o /dev/null -w '%{redirect_url}' \
    "https://github.com/$REPO/releases/latest" 2>/dev/null)" ||
    die "failed to check for updates"

  # A repository with no releases redirects to the releases page itself, and
  # its last path component is "releases" -- which would pass for a tag name
  # and be wrong.
  [[ "$url" == */releases/tag/* ]] || die "no releases found for $REPO"

  printf '%s\n' "${url##*/}"
}

check_update() {
  local latest
  latest="$(fetch_latest_version)"
  if [[ -z "$latest" ]]; then
    die "could not determine latest version"
  fi
  if [[ "$latest" == "$VERSION" ]]; then
    echo "open $VERSION is up to date."
  else
    echo "open $VERSION is outdated. Latest version: $latest"
    echo "Run 'open --update' to update."
  fi
}

update_die() {
  local workdir="$1"; shift
  rm -rf "$workdir"
  die "$@"
}

self_update() {
  local latest
  latest="$(fetch_latest_version)"
  if [[ -z "$latest" ]]; then
    die "could not determine latest version"
  fi
  if [[ "$latest" == "$VERSION" ]]; then
    echo "open $VERSION is already up to date."
    exit 0
  fi

  local self workdir base asset source_file helper_src
  self="$(realpath "$0")"
  workdir="$(mktemp -d /tmp/winopen-update-XXXXXX)"
  base="https://github.com/$REPO/releases/download/$latest"
  asset="winopen-${latest}.tar.gz"

  echo "Updating open $VERSION -> $latest..."

  # The release asset, as install.sh takes it and for the same reason: a tag can
  # be moved and raw.githubusercontent.com follows it, while an asset cannot be
  # replaced without showing. No fallback -- an update only goes to the latest.
  curl -fsSL "$base/$asset" -o "$workdir/$asset" 2>/dev/null ||
    update_die "$workdir" "release $latest has no $asset; nothing was changed"

  curl -fsSL "$base/SHA256SUMS" -o "$workdir/SHA256SUMS" 2>/dev/null ||
    update_die "$workdir" "release $latest has a tarball but no SHA256SUMS; nothing was changed"

  ( cd "$workdir" && sha256sum --ignore-missing -c SHA256SUMS >/dev/null 2>&1 ) ||
    update_die "$workdir" "checksum mismatch for $asset; nothing was changed"

  tar -xzf "$workdir/$asset" -C "$workdir" 2>/dev/null ||
    update_die "$workdir" "could not unpack $asset; nothing was changed"

  source_file="$workdir/winopen-${latest}/open"
  helper_src="$workdir/winopen-${latest}/libexec/open-url.ps1"
  [[ -f "$source_file" ]] ||
    update_die "$workdir" "$asset does not carry an open to install; nothing was changed"

  # Deliberately not `sudo`-ing this ourselves, and deliberately not asking the
  # user to re-run the whole command as root either: that would put the network
  # fetch under root as well, which is the part worth keeping out of it. The
  # download has already happened as this user, so what is left is one
  # privileged copy, printed for them to run. The download stays where it is,
  # so the command has something to copy.
  if [[ ! -w "$self" ]]; then
    local helper
    helper="$(winopen_libexec)" || helper=""
    {
      echo "Downloaded and verified $latest to $source_file."
      echo "$self is not writable by you, so the last step needs root:"
      echo "    sudo install -m 755 $source_file $self"
      if [[ -n "$helper" && -f "$helper_src" ]]; then
        echo "    sudo install -m 644 $helper_src $helper"
      fi
    } >&2
    exit 1
  fi

  install -m 755 "$source_file" "$self"
  echo "Updated successfully: $("$self" --version)"

  # Non-zero when it printed a command naming these files, so they must stay.
  if update_helper "$helper_src"; then
    rm -rf "$workdir"
  fi
}

# One release, one pair: a new tool beside a stale helper does not fail, it
# falls back silently. In place only -- installing one belongs to the install.
update_helper() {
  local src="$1" helper
  helper="$(winopen_libexec)" || return 0

  if [[ ! -f "$src" ]]; then
    warn "this release carries no virtual-desktop helper; $helper is still the old one"
    return 0
  fi

  if [[ ! -w "$helper" ]]; then
    {
      echo "$helper is not writable by you, so refreshing it needs root:"
      echo "    sudo install -m 644 $src $helper"
    } >&2
    return 1
  fi

  install -m 644 "$src" "$helper"
  echo "Refreshed the virtual-desktop helper: $helper"
}

version() {
  echo "open $VERSION (WSL)"
}

# Windows resolves any registered scheme through ShellExecute, and there are far
# more of them than the three this used to list -- vscode:, ms-settings:, file:
# and whatever else is installed. So recognise the shape of a scheme (RFC 3986)
# rather than an allowlist, and let Windows decide what it can handle.
#
# An existing path wins the tiebreak: a file genuinely named "foo:bar" is a
# file. -u overrides that, which is the flag's entire purpose.
is_url() {
  [[ "$1" =~ ^[a-zA-Z][a-zA-Z0-9+.-]*: ]] && [[ ! -e "$1" ]]
}

# The -- matters: without it wslpath reads a target named "-foo" as its own
# flags and prints its usage, so `open -- -foo` protected our parser and then
# failed here anyway. Same for dirname below.
to_winpath() {
  [[ -e "$1" ]] || die "no such file or directory: $1"
  wslpath -aw -- "$1" 2>/dev/null || die "cannot convert path: $1"
}

# explorer.exe returns 1 whether it succeeded or not, so its status carries no
# information and must not be allowed to stand as ours. Left unhandled, set -e
# takes it as failure: a single target exits 1 after opening fine, and a list of
# them stops after the first.
run_explorer() {
  explorer.exe "$@" 2>/dev/null || true
}

# -a with nothing to open. `start` takes an application on its own, so this is
# the same call as the -a branch of open_target minus the document.
launch_app() {
  local -a extra=()

  if $flag_new; then
    local nflag
    if nflag="$(new_instance_flag "$app")"; then
      extra+=("$nflag")
    else
      warn "-n: no new-instance flag known for ${app##*/}; opening normally, which may reuse a running window"
    fi
  fi
  if [[ ${#app_args[@]} -gt 0 ]]; then
    extra+=("${app_args[@]}")
  fi

  local -a cmd=(cmd.exe /C start "")
  if $flag_wait; then
    cmd+=(/WAIT)
  fi
  cmd+=("$app")
  if [[ ${#extra[@]} -gt 0 ]]; then
    cmd+=("${extra[@]}")
  fi

  "${cmd[@]}" 2>/dev/null
}

# The paths that never reach the -n block below -- Explorer, a Linux editor, the
# class-based -t open -- have no flag to pass and no application to pass it to.
# Silence there would break the contract every other -n case keeps.
warn_no_new_instance() {
  if $flag_new; then
    warn "-n: cannot ask $1 for a new window; opening normally"
  fi
}

# The PowerShell helper that keeps a URL's tab on the desktop in view. Beside
# the tool when installed, in the source tree when run from a clone. Absent --
# a single-file install, or a release from before it existed -- everything still
# works, just without this.
winopen_libexec() {
  local dir candidate
  dir="$(dirname "$(realpath "$0")")"
  for candidate in "$dir/../libexec/winopen/open-url.ps1" "$dir/libexec/open-url.ps1"; do
    if [[ -r "$candidate" ]]; then
      # Resolved, so no bin/../libexec reaches a message someone has to read.
      realpath "$candidate"
      return 0
    fi
  done
  return 1
}

# Windows gives a URL to the running browser, which opens it in whichever of
# its windows was last active -- on whatever desktop that window happens to be.
# So the tab lands out of sight, or the view is dragged across to follow it.
#
# Returns non-zero for anything it cannot improve on: no PowerShell, no helper,
# an unknown scheme, or a browser it has no window flag for. The caller then
# does what it would have done anyway.
open_url_on_current_desktop() {
  local url="$1" helper

  [[ "${WINOPEN_DESKTOP:-1}" != "0" ]] || return 1
  command -v powershell.exe >/dev/null 2>&1 || return 1
  helper="$(winopen_libexec)" || return 1

  powershell.exe -NoProfile -ExecutionPolicy Bypass \
    -File "$(wslpath -aw "$helper")" -Url "$url" >/dev/null 2>&1
}

# ShellExecuteEx, for the one thing `start` cannot express: opening a file with
# a class other than its own extension, which is what -t needs -- whatever
# handles .txt, not whatever handles this file.
#
# Values travel as environment variables rather than inside the PowerShell
# source, so a target containing quotes, spaces or ampersands needs no escaping
# on the way through. WSLENV is what carries them across the boundary, and it is
# appended to rather than replaced -- Windows Terminal already sets it.
#
# SEE_MASK_NOASYNC matters: without it the launch can be abandoned when the
# calling process exits, and this one exits immediately.
shell_execute() {
  local file="$1" class="$2" show="$3"

  command -v powershell.exe >/dev/null 2>&1 || return 1

  WINOPEN_SE_FILE="$file" \
  WINOPEN_SE_CLASS="$class" \
  WINOPEN_SE_SHOW="$show" \
  WINOPEN_SE_WAIT="$($flag_wait && echo 1 || echo 0)" \
  WSLENV="${WSLENV:+$WSLENV:}WINOPEN_SE_FILE:WINOPEN_SE_CLASS:WINOPEN_SE_SHOW:WINOPEN_SE_WAIT" \
  powershell.exe -NoProfile -Command '
Add-Type -TypeDefinition @"
using System;using System.Runtime.InteropServices;
[StructLayout(LayoutKind.Sequential, CharSet=CharSet.Unicode)]
public struct SEI {
  public int cbSize; public uint fMask; public IntPtr hwnd;
  [MarshalAs(UnmanagedType.LPWStr)] public string lpVerb;
  [MarshalAs(UnmanagedType.LPWStr)] public string lpFile;
  [MarshalAs(UnmanagedType.LPWStr)] public string lpParameters;
  [MarshalAs(UnmanagedType.LPWStr)] public string lpDirectory;
  public int nShow; public IntPtr hInstApp; public IntPtr lpIDList;
  [MarshalAs(UnmanagedType.LPWStr)] public string lpClass;
  public IntPtr hkeyClass; public uint dwHotKey; public IntPtr hIcon; public IntPtr hProcess;
}
public static class WinShell {
  [DllImport("shell32.dll", CharSet=CharSet.Unicode, SetLastError=true)]
  public static extern bool ShellExecuteExW(ref SEI i);
  [DllImport("kernel32.dll")] public static extern uint WaitForSingleObject(IntPtr h, uint ms);
}
"@
$i = New-Object SEI
$i.cbSize = [Runtime.InteropServices.Marshal]::SizeOf($i)
$i.fMask  = 0x100
$i.lpFile = $env:WINOPEN_SE_FILE
$i.nShow  = [int]$env:WINOPEN_SE_SHOW
if ($env:WINOPEN_SE_CLASS)  { $i.fMask = $i.fMask -bor 0x1; $i.lpClass = $env:WINOPEN_SE_CLASS }
if ($env:WINOPEN_SE_WAIT -eq "1") { $i.fMask = $i.fMask -bor 0x40 }
if (-not [WinShell]::ShellExecuteExW([ref]$i)) { exit 1 }
if ($env:WINOPEN_SE_WAIT -eq "1" -and $i.hProcess -ne [IntPtr]::Zero) {
  [void][WinShell]::WaitForSingleObject($i.hProcess, 0xFFFFFFFF)
}
exit 0' >/dev/null 2>&1
}

# Windows has no general "new instance" switch. ShellExecute asks the
# application, and most of them single-instance themselves -- which is exactly
# why a browser handed a URL puts a tab in the window that was last active. What
# does work is the application's own flag, so -n is only as good as this table.
# Anything not in it is opened normally, with a warning: see warn().
new_instance_flag() {
  # AssocQueryString answers with a Windows path, so the separator to strip is
  # a backslash; -a takes a bare name or a Unix path, so strip both.
  local exe="${1##*/}"
  exe="${exe##*\\}"
  case "${exe,,}" in
    chrome.exe|msedge.exe|brave.exe|vivaldi.exe|opera.exe|thorium.exe)
      echo "--new-window" ;;
    firefox.exe|librewolf.exe|waterfox.exe)
      echo "-new-window" ;;
    *)
      return 1 ;;
  esac
}

# What Windows would launch for a scheme or a file extension. AssocQueryString
# is the only reliable answer on Windows 11: `ftype` returns nothing for a Store
# app, and the UserChoice key holds an AppX id with no command line. The #13
# prototype also found UserChoice disagreeing outright -- it said Edge for http
# while the shell launched Chrome.
#
# PowerShell stays optional: without it -n simply cannot resolve a default
# application, and says so rather than guessing.
windows_default_app() {
  local assoc="$1"
  command -v powershell.exe >/dev/null 2>&1 || return 1

  # Through the environment, not spliced into the script text: with -u the
  # caller chooses the scheme outright, and an extension can hold a quote, so
  # embedding it would let the value end the string literal it sits in.
  WINOPEN_ASSOC="$assoc" \
  WSLENV="${WSLENV:+$WSLENV:}WINOPEN_ASSOC" \
  powershell.exe -NoProfile -Command "
Add-Type -TypeDefinition @\"
using System;using System.Text;using System.Runtime.InteropServices;
public static class WinAssoc {
 [DllImport(\"Shlwapi.dll\", CharSet=CharSet.Unicode)]
 private static extern uint AssocQueryString(int f,int s,string a,string e,StringBuilder o,ref uint c);
 public static string Exe(string a){var sb=new StringBuilder(1024);uint n=(uint)sb.Capacity;
 return AssocQueryString(0,2,a,\"open\",sb,ref n)==0?sb.ToString():null;}}
\"@
[WinAssoc]::Exe(\$env:WINOPEN_ASSOC)" 2>/dev/null | tr -d '\r' | head -1
}

# The key AssocQueryString wants: a scheme without its colon for a URL, an
# extension with its dot for a file.
assoc_key_for() {
  local target="$1" url_target="$2"
  if $url_target; then
    printf '%s\n' "${target%%:*}"
    return 0
  fi
  local base="${target##*/}"
  [[ "$base" == *.* ]] || return 1
  printf '.%s\n' "${base##*.}"
}

# notepad.exe is the TextEdit analogue, so -e is pinned to it and only -t takes
# the override. With no override, -t does not come through here at all: it asks
# Windows what handles .txt, which open_target does with SEE_MASK_CLASSNAME.
# This is the fallback for when there is no powershell.exe to ask with.
resolve_editor() {
  if [[ "$editor_mode" == "textedit" ]]; then
    echo "notepad.exe"
  else
    echo "${WINOPEN_EDITOR:-notepad.exe}"
  fi
}

# `start` returns as soon as Windows has taken the target, and takes /WAIT when
# the caller asked to wait. One place to assemble the command line, so -W and
# --args behave the same whether an application was named or not.
start_open() {
  local opener="$1" addressed="$2"
  local -a cmd=(cmd.exe /C start "")

  if $flag_wait; then
    cmd+=(/WAIT)
  fi
  if [[ -n "$opener" ]]; then
    cmd+=("$opener")
  fi
  # Before the target: a browser reads --new-window as a flag only ahead of the
  # URL, and behind it would be taken for a second thing to open.
  if [[ ${#opener_flags[@]} -gt 0 ]]; then
    cmd+=("${opener_flags[@]}")
  fi
  cmd+=("$addressed")
  if [[ ${#app_args[@]} -gt 0 ]]; then
    cmd+=("${app_args[@]}")
  fi

  "${cmd[@]}" 2>/dev/null
}

# Two independent questions, which the old chain collapsed into one: how the
# target is *addressed* -- a URL passes through as it stands, anything else
# becomes a Windows path -- and *what opens it*. Testing for a URL first and
# returning made it answer both, so -a and -W were silently dropped for every
# URL: `open -a chrome.exe https://x` did not use Chrome.
open_target() {
  local target="$1" forced_url="$2"

  local url_target=false
  if $forced_url || is_url "$target"; then
    url_target=true
  fi

  # These need a file to point at. Ignoring them for a URL is how the old chain
  # behaved; saying so is better than doing something else silently.
  if $url_target; then
    if $flag_enclosing; then die "-D needs a file, not a URL: $target"; fi
    if $flag_reveal; then die "-R needs a file, not a URL: $target"; fi
    if [[ -n "$editor_mode" ]]; then die "-e and -t need a file, not a URL: $target"; fi
  fi

  local addressed
  if $url_target; then
    addressed="$target"
  else
    addressed="$(to_winpath "$target")"
  fi

  if $flag_enclosing; then
    run_explorer "$(to_winpath "$(dirname -- "$target")")"
    return
  fi

  if $flag_reveal; then
    run_explorer /select,"$addressed"
    return
  fi

  # A Linux editor is run in place, on the Linux path: Windows cannot launch it,
  # and for a terminal editor blocking is exactly what the caller wants. A
  # Windows one goes through `start` like everything else, so it returns at once
  # and -W means there what it means everywhere. Running it in the foreground
  # instead made -e and -t wait for the editor to exit whether or not -W was
  # given -- measured at 5s either way against an editor that sleeps 5s.
  # Per target, not per run: appending to a script-level array left the flag on
  # every later target, and the second one was handed --new-window as the
  # program to run rather than the application.
  local -a opener_flags=()

  local opener=""
  if [[ -n "$editor_mode" ]]; then
    # -t means whatever Windows registered for .txt, which is not the same
    # question as "what opens this file". SEE_MASK_CLASSNAME asks it directly,
    # and is the only way to reach it: on Windows 11 the answer is a Store app
    # that `ftype` cannot name and whose path is unreadable from WSL. Falls
    # through to resolve_editor when there is no powershell.exe to ask with.
    if [[ "$editor_mode" == "default" && -z "${WINOPEN_EDITOR:-}" ]]; then
      # lpParameters has to be NULL when lpFile is a document: with it set,
      # ShellExecuteEx reports success and opens nothing at all. So --args
      # cannot travel this path -- losing them beats losing the open.
      if [[ ${#app_args[@]} -gt 0 ]]; then
        warn "--args: the .txt handler is asked to open the document itself, which takes no arguments; ignoring them"
      fi
      if shell_execute "$addressed" ".txt" 1; then
        warn_no_new_instance "the .txt handler"
        return
      fi
    fi

    local editor editor_path
    editor="$(resolve_editor)"
    editor_path="$(command -v "$editor" 2>/dev/null)" || die "editor not found: $editor"
    if [[ "$editor_path" != /mnt/* ]]; then
      warn_no_new_instance "${editor##*/}"
      "$editor" "$target"
      return
    fi
    opener="$editor"
  elif [[ -n "$app" ]]; then
    opener="$app"
  fi

  # A directory with nothing else asked for belongs to Explorer.
  if [[ -z "$opener" ]] && ! $url_target && [[ -d "$target" ]]; then
    warn_no_new_instance "Explorer"
    run_explorer "$addressed"
    return
  fi

  if $flag_new; then
    # With no -a, the application is whatever Windows would have picked, so it
    # has to be resolved before it can be asked for a new window.
    local resolved="$opener" key nflag
    if [[ -z "$resolved" ]]; then
      # Both of these are allowed to fail -- no extension to look up by, or no
      # powershell.exe to ask with. A bare assignment would end the run instead,
      # which is the opposite of opening the target and saying what was missed.
      key="$(assoc_key_for "$target" "$url_target")" || key=""
      if [[ -n "$key" ]]; then
        resolved="$(windows_default_app "$key")" || resolved=""
      fi
    fi

    if [[ -z "$resolved" ]]; then
      warn "-n: could not work out which application opens $target; opening normally"
    elif nflag="$(new_instance_flag "$resolved")"; then
      opener_flags+=("$nflag")
      # Naming the application is the point: handing the target to the default
      # handler would let the running instance take it, which is what -n asks
      # us not to do.
      opener="$resolved"
    else
      warn "-n: no new-instance flag known for ${resolved##*/}; opening normally, which may reuse a running window"
    fi
  fi

  # A plain URL, with nothing else asked for, is the case worth improving: -a
  # names the application already, -n is asking for a new window rather than
  # reuse, and -W wants to wait for something this cannot wait on.
  if $url_target && [[ -z "$opener" ]] && ! $flag_new && ! $flag_wait &&
     [[ ${#app_args[@]} -eq 0 ]]; then
    if open_url_on_current_desktop "$addressed"; then
      return
    fi
  fi

  start_open "$opener" "$addressed"
}


# PATH resolves "xdg-open" to the shim itself, so walking it by hand and
# skipping anything that leads back here is the only way to reach the one we
# shadow. Without this, delegating would simply re-enter this script forever.
find_real_xdg_open() {
  local self dir candidate
  self="$(realpath "$0")"
  local IFS=:
  for dir in $PATH; do
    candidate="$dir/xdg-open"
    [[ -x "$candidate" ]] || continue
    [[ "$(realpath "$candidate" 2>/dev/null)" == "$self" ]] && continue
    printf '%s\n' "$candidate"
    return 0
  done
  return 1
}

# Invoked through the symlink named xdg-open. xdg-open's contract is narrower
# than ours -- exactly one target, and exit codes callers branch on -- so
# honouring it matters more than reusing our own argument handling.
#
# We never fall back to the system xdg-open on failure, because Windows gives
# us no failure to detect: `start` reports success for a scheme nothing has
# registered. WINOPEN_XDG=0 is the manual version of that fallback, for getting
# the old behaviour back without uninstalling anything.
xdg_open_main() {
  case "${1:-}" in
    --help|--manual) xdg_usage; exit 0 ;;
    --version)       echo "xdg-open (winopen $VERSION)"; exit 0 ;;
  esac

  [[ $# -eq 1 ]] || {
    echo "xdg-open: expected exactly one file or URL" >&2
    exit 1
  }

  local target="$1"

  if [[ "${WINOPEN_XDG:-1}" == "0" ]]; then
    local real
    real="$(find_real_xdg_open)" || {
      echo "xdg-open: WINOPEN_XDG=0 and no other xdg-open on PATH" >&2
      exit 3
    }
    exec "$real" "$target"
  fi

  # The spec numbers a missing file 2; our own die() would call it 1.
  if ! is_url "$target" && [[ ! -e "$target" ]]; then
    echo "xdg-open: no such file or directory: $target" >&2
    exit 2
  fi

  open_target "$target" false
  exit 0
}

# The shim is a symlink rather than a generated wrapper: one file stays one
# file, so --update and the release tarball have nothing extra to track, and
# the shim can never drift out of step with the tool it points at.
xdg_dest() {
  if [[ -n "${PREFIX:-}" ]]; then
    echo "$PREFIX/bin/xdg-open"
  else
    # Beside the tool, so the two stay together wherever the install put them.
    # PREFIX still decides, and elsewhere is often the point -- see install_xdg.
    echo "$(dirname "$(realpath "$0")")/xdg-open"
  fi
}

# Root is never assumed. If the destination is not this user's to write, the
# commands that would do it are printed and nothing happens.
#
# A tool run dozens of times a day should not be able to escalate on its own,
# and re-running under sudo is not a worse experience -- it is the same
# operation with the decision made by the person making it. Under sudo the
# writability test simply passes and this never fires, so there is no second
# code path.
require_writable() {
  local target="$1" flag="$2"; shift 2
  [[ -w "$target" ]] && return 0

  local prefix_hint=""
  [[ -n "${PREFIX:-}" ]] && prefix_hint="PREFIX=$PREFIX "

  {
    echo "$target is not writable by you, so this needs root."
    echo "It would run:"
    local cmd
    for cmd in "$@"; do
      echo "    $cmd"
    done
    echo
    echo "Nothing has been changed. Run it again as root:"
    echo "    sudo ${prefix_hint}$0 $flag"
  } >&2
  exit 1
}

install_xdg() {
  local dest self bindir backup
  dest="$(xdg_dest)"
  bindir="$(dirname "$dest")"
  self="$(realpath "$0")"

  [[ -d "$bindir" ]] || die "no such directory: $bindir (set PREFIX)"

  # Everything is decided before anything is done, so the sudo notice can list
  # the real commands rather than a guess at them.
  backup=""
  if [[ -e "$dest" || -L "$dest" ]]; then
    if [[ "$(realpath "$dest" 2>/dev/null)" == "$self" ]]; then
      echo "Already installed: $dest -> $self"
      return 0
    fi
    # Only ever a file at our own target path -- a packaged /usr/bin/xdg-open is
    # shadowed, not touched, so there is nothing of dpkg's to back up.
    backup="$dest.winopen-backup"
    [[ -e "$backup" ]] && die "refusing to overwrite an existing backup: $backup"
  fi

  if [[ -n "$backup" ]]; then
    require_writable "$bindir" --install-xdg "mv $dest $backup" "ln -s $self $dest"
    echo "Backing up $dest -> $backup"
    mv "$dest" "$backup"
  else
    require_writable "$bindir" --install-xdg "ln -s $self $dest"
  fi

  ln -s "$self" "$dest"
  echo "Installed $dest -> $self"

  # Said every time: a shim nothing finds looks exactly like one that works.
  echo
  echo "Programs find it only if $bindir comes first on the PATH they run with."
  echo "Services, and anything Windows starts in WSL, get a short fixed one."
  if [[ "$bindir" != "/usr/local/bin" ]]; then
    echo "For those: PREFIX=/usr/local $0 --install-xdg"
  fi
  echo
  echo "To route \$BROWSER the same way, add to your shell config:"
  echo "    export BROWSER=$dest"
  echo
  echo "Undo with: open --uninstall-xdg"
  echo "Bypass for one command with: WINOPEN_XDG=0 xdg-open <target>"
}

uninstall_xdg() {
  local dest self bindir backup
  dest="$(xdg_dest)"
  bindir="$(dirname "$dest")"
  self="$(realpath "$0")"

  [[ -e "$dest" || -L "$dest" ]] || die "not installed: $dest"
  [[ "$(realpath "$dest" 2>/dev/null)" == "$self" ]] ||
    die "$dest was not installed by winopen; leaving it alone"

  backup="$dest.winopen-backup"
  [[ -e "$backup" ]] || backup=""

  if [[ -n "$backup" ]]; then
    require_writable "$bindir" --uninstall-xdg "rm -f $dest" "mv $backup $dest"
  else
    require_writable "$bindir" --uninstall-xdg "rm -f $dest"
  fi

  rm -f "$dest"
  echo "Removed $dest"

  if [[ -n "$backup" ]]; then
    mv "$backup" "$dest"
    echo "Restored $dest from $backup"
  fi
}


# --- Argument parsing ---

flag_enclosing=false
flag_reveal=false
flag_wait=false
flag_new=false

# Everything after --args, passed to the launched application rather than
# opened. Kept apart from targets so the two cannot be confused.
app_args=()

# Flags for the launched application that winopen adds itself, as -n does.
# Separate from app_args, which are the caller's.
opener_flags=()

# "" | textedit (-e) | default (-t). macOS keeps these apart: -e names one
# application, -t asks the system which one handles text. Holding both in a
# single variable makes the later flag win, as a repeated flag normally does.
editor_mode=""
flag_stdin=false
app=""

# Two arrays with matching indices. -u marks one target as a URL and says
# nothing about the others, so "forced" cannot live in a single flag variable.
targets=()
targets_forced_url=()

add_target() {
  targets+=("$1")
  targets_forced_url+=("${2:-false}")
}

# Called through the shim, not as `open`. Checked after the flag defaults above
# are set, since open_target reads them, and before our own parser, whose
# argument grammar is not xdg-open's.
if [[ "$(basename -- "$0")" == "xdg-open" ]]; then
  xdg_open_main "$@"
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)    usage; exit 0 ;;
    -V|--version) version; exit 0 ;;
    --check-update) check_update; exit 0 ;;
    --update)     self_update; exit 0 ;;
    --install-xdg)   install_xdg; exit 0 ;;
    --uninstall-xdg) uninstall_xdg; exit 0 ;;
    -D)           flag_enclosing=true; shift ;;
    -R)           flag_reveal=true; shift ;;
    -e)           editor_mode="textedit"; shift ;;
    -t)           editor_mode="default"; shift ;;
    -W)           flag_wait=true; shift ;;
    -n)           flag_new=true; shift ;;
    -f)           flag_stdin=true; shift ;;
    -a)
      [[ -n "${2:-}" ]] || die "-a requires an application name"
      app="$2"; shift 2 ;;
    -u)
      [[ -n "${2:-}" ]] || die "-u requires a URL"
      add_target "$2" true; shift 2 ;;
    --args)
      shift
      app_args=("$@")
      break ;;
    --)
      shift
      for arg in "$@"; do add_target "$arg"; done
      break ;;
    -*)           die "unknown option: $1" ;;
    *)            add_target "$1"; shift ;;
  esac
done

# --- Stdin mode ---

if $flag_stdin; then
  # The suffix matters: an extensionless file has no association, so handing it
  # to the default handler asks Windows to open something it knows nothing
  # about.
  tmpfile="$(mktemp --suffix=.txt /tmp/winopen-XXXXXX)"
  cat > "$tmpfile"

  # open(1) defines -f as reading stdin and opening the result "in the default
  # text editor", so it implies -t -- unless the caller already said what to
  # open it with. -a counts: open_target consults editor_mode before app, so an
  # implied -t here would have quietly overruled an explicit -a.
  if [[ -z "$editor_mode" && -z "$app" ]]; then
    editor_mode="default"
  fi

  # Deliberately not deleted. `start` returns as soon as it has handed the file
  # over, long before the application has read it, so removing it here removed
  # it out from under the app -- the file was reliably gone a second later.
  # Leaving it for the OS to reap is what macOS does, and the only option that
  # does not either race the application or block until it exits.
  add_target "$tmpfile"
fi

# --- Validate targets ---

if [[ ${#targets[@]} -eq 0 ]]; then
  # `open -a Foo` with no file launches the application with no document, so an
  # empty target list is only a mistake when there is no application to launch
  # either.
  if [[ -n "$app" ]]; then
    launch_app
    exit 0
  fi

  # A bare `open` is a mistake, not a request, so the usage goes to stderr and
  # the status says so -- unlike -h, where the user asked and gets stdout and 0.
  # Deliberately not defaulting to the current directory: `open .` is the
  # documented idiom, and requiring the dot is what macOS and `code` both do.
  usage >&2
  exit 1
fi

# --- Dispatch ---

for i in "${!targets[@]}"; do
  open_target "${targets[$i]}" "${targets_forced_url[$i]}"
done
